// 彩虹桥 ends (r5, GGbot): ground halo + petals + little flowers (technique 0) and the GPU motes (technique 1).
// Both are built at runtime by RainbowBridgeMesh.ts (no GLB, no ParticleSystem module). a_normal = (seed, kind, size):
//   kind 0 halo     additive (premultiplied with alpha 0)      kind 4 ground petal / flower stem / flower head, opaque look (alpha 1)
//   kind 1 glow dot additive, rises a_color.w metres            kind 2 falling petal, alpha, falls a_color.w metres and spins
//   kind 3 curb sparkle, additive twinkle
// Colours are authored in sRGB (sRGB-ready forward RT, like glass-sign). endParams = [halo, motes, ground petals, night].
// Depth: 3.8.8's WebGL/WebGL2 backends never enable POLYGON_OFFSET_FILL, so a rasterizer depthBias does nothing there; instead the
// vertices move a small, distance-scaled step toward the camera along the view ray (identical pixels, nearer depth), on top of
// the 2.5 cm (halo) / 1.2 cm (petals) lift over the ground.
// Order (transparent queue: model priority → pass priority → depth): ground max - 11 < deck max - 10 < motes max - 9.
CCEffect %{
  techniques:
  - name: ground
    passes:
    - vert: rbh-vs:vertGround
      frag: rbh-fs:frag
      priority: max - 11
      properties: &props
        endParams: { value: [0.22, 0.75, 1.0, 0.0], editor: { tooltip: "halo, motes, ground petals, night (0..1)" } }
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: true, depthWrite: false }
      blendState: &blend
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
  - name: motes
    passes:
    - vert: rbh-vs:vertMotes
      frag: rbh-fs:frag
      priority: max - 9
      properties: *props
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: true, depthWrite: false }
      blendState: *blend
}%
CCProgram rbh-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec3 a_normal;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 v_color;
  out vec3 v_shape;
  out float v_kind;
  vec4 toCamera (vec4 wp, float k, float cap) {
    vec3 toCam = cc_cameraPos.xyz - wp.xyz;
    float dist = max(length(toCam), 1e-3);
    wp.xyz += toCam / dist * min(cap, k * dist);
    return wp;
  }
  vec4 vertGround () {
    vec4 wp = toCamera(cc_matWorld * vec4(a_position, 1.0), 0.003, 0.06);
    v_color = a_color; v_kind = a_normal.y; v_shape = vec3(0.0);
    return cc_matViewProj * wp;
  }
  vec4 vertMotes () {
    float seed = a_normal.x, kind = a_normal.y, size = a_normal.z;
    vec4 wp = cc_matWorld * vec4(a_position, 1.0);
    vec2 corner = a_texCoord;
    float life = kind < 1.5 ? 2.5 + seed : (kind < 2.5 ? 3.0 : 1.6 + seed);
    float t = fract(cc_time.x / life + seed * 7.31);
    float env = sin(3.14159 * t);
    vec3 off = vec3(0.0);
    float ang = 0.0;
    if (kind < 1.5) {                        // glow dot: rises, eases out, slight sway
      off.y = a_color.w * (1.0 - (1.0 - t) * (1.0 - t));
      off.x = 0.06 * sin(t * 6.0 + seed * 20.0);
      off.z = 0.06 * cos(t * 5.0 + seed * 13.0);
    } else if (kind < 2.5) {                 // falling petal: falls, drifts, spins
      off.y = -a_color.w * t;
      off.x = 0.15 * sin(t * 5.0 + seed * 30.0);
      off.z = 0.12 * cos(t * 4.0 + seed * 17.0);
      ang = t * 7.0 + seed * 6.28;
      env = smoothstep(0.0, 0.1, t) * (1.0 - smoothstep(0.85, 1.0, t));
    } else {                                 // curb sparkle: twinkles in place
      env = pow(max(sin(6.28318 * t), 0.0), 6.0);
    }
    float ca = cos(ang), sa = sin(ang);
    vec2 rc = vec2(ca * corner.x - sa * corner.y, sa * corner.x + ca * corner.y);
    vec3 right = vec3(cc_matView[0][0], cc_matView[1][0], cc_matView[2][0]);
    vec3 up = vec3(cc_matView[0][1], cc_matView[1][1], cc_matView[2][1]);
    wp.xyz += off + (right * rc.x + up * rc.y * (kind > 1.5 && kind < 2.5 ? 0.55 : 1.0)) * size;
    v_color = vec4(a_color.rgb, env); v_kind = kind; v_shape = vec3(corner, t);
    return cc_matViewProj * wp;
  }
}%
CCProgram rbh-fs %{
  precision highp float;
  in vec4 v_color;
  in vec3 v_shape;
  in float v_kind;
  uniform RainbowEnds { vec4 endParams; };
  vec4 frag () {
    float k = v_kind;
    if (k < 0.5) {                            // halo: additive (alpha 0), radial falloff baked in a_color.a
      return vec4(v_color.rgb * v_color.a * endParams.x, 0.0);
    }
    if (k > 3.5) {                            // ground petals / flowers: solid, dimmed at night like the meadow props
      return vec4(v_color.rgb * endParams.z, 1.0);
    }
    float d = length(v_shape.xy);
    if (k < 1.5) {                            // glow dot: soft disc, additive
      float a = (1.0 - smoothstep(0.15, 1.0, d)) * v_color.a * endParams.y;
      return vec4(v_color.rgb * a, 0.0);
    }
    if (k < 2.5) {                            // petal: soft ellipse, alpha-blended
      float a = (1.0 - smoothstep(0.7, 1.0, d)) * v_color.a * min(1.0, endParams.y + 0.2);
      return vec4(v_color.rgb * a, a);
    }
    float star = max(1.0 - smoothstep(0.0, 0.18, abs(v_shape.x) * abs(v_shape.y) * 4.0), 0.0) * (1.0 - smoothstep(0.4, 1.0, d));
    float a = star * v_color.a * endParams.y;   // curb sparkle: 4-point star, additive
    return vec4(v_color.rgb * a, 0.0);
  }
}%

// Fixed studio key/fill for the offscreen UI object. Never reads or changes the world's lighting.
CCEffect %{
  techniques:
  - passes:
    - vert: warm-button-vs:vert
      frag: warm-button-fs:frag
      rasterizerState: { cullMode: back }
      depthStencilState: { depthTest: true, depthWrite: true }
}%
CCProgram warm-button-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec3 a_normal;
  in vec4 a_color;
  out vec3 v_normal;
  out vec3 v_color;
  vec4 vert () {
    v_normal = a_normal;
    v_color = a_color.rgb;
    return cc_matViewProj * cc_matWorld * vec4(a_position, 1.0);
  }
}%
CCProgram warm-button-fs %{
  precision highp float;
  in vec3 v_normal;
  in vec3 v_color;
  vec4 frag () {
    vec3 n = normalize(v_normal);
    vec3 key = normalize(vec3(-0.55, 0.72, 0.75));
    vec3 fill = normalize(vec3(0.7, -0.2, 0.45));
    float diffuse = 0.43 + 0.75 * max(dot(n, key), 0.0) + 0.09 * max(dot(n, fill), 0.0);
    vec3 halfVector = normalize(key + vec3(0.0, 0.0, 1.0));
    float specular = 0.075 * pow(max(dot(n, halfVector), 0.0), 28.0);
    vec3 linearColor = v_color * diffuse + vec3(1.0, 0.89, 0.70) * specular;
    // RT is an sRGB-ready UI image: avoid world exposure, fog, HDR and double tone mapping.
    vec3 lo = linearColor * 12.92;
    vec3 hi = 1.055 * pow(max(linearColor, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
    return vec4(mix(lo, hi, step(vec3(0.0031308), linearColor)), 1.0);
  }
}%

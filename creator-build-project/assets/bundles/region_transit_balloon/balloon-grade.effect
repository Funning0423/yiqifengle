CCEffect %{
  techniques:
  - name: cloud-day
    passes:
    - vert: grade-vs:vert
      frag: cloud-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState:
        depthTest: true
        depthWrite: true
      properties:
        mainColor: { value: [1, 1, 1, 1] }
  - name: sky-dither
    passes:
    - vert: grade-vs:vert
      frag: sky-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState:
        depthTest: true
        depthWrite: false
      properties:
        mainColor: { value: [1, 1, 1, 1] }
}%

CCProgram grade-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec4 a_color;
  out vec3 v_color;
  vec4 vert () {
    v_color = a_color.rgb;
    return cc_matViewProj * cc_matWorld * vec4(a_position, 1.0);
  }
}%

CCProgram cloud-fs %{
  precision highp float;
  in vec3 v_color;
  // Authored floor shade only spans ~0.06, so the cruise deck reads as one flat wash.
  // Stretch that height-correlated shade into white tops and grey-blue valleys.
  vec4 frag () {
    float l = dot(v_color, vec3(0.30, 0.59, 0.11));
    float d = clamp((l - 0.82) / 0.059, -2.0, 2.0);
    float u = clamp(0.5 + d * 0.55, 0.0, 1.0);
    vec3 c = mix(vec3(0.55, 0.64, 0.75), vec3(1.0), u);
    return vec4(c, 1.0);
  }
}%

CCProgram sky-fs %{
  precision highp float;
  in vec3 v_color;
  // Break 8-bit bands on the coarse sky-dome rings. ±2.5/255 is below a contour, above a flat step.
  float ign (vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
  }
  vec4 frag () {
    vec3 c = v_color + (ign(gl_FragCoord.xy) - 0.5) * (2.5 / 255.0);
    return vec4(clamp(c, 0.0, 1.0), 1.0);
  }
}%

CCEffect %{
  techniques:
  - name: cloud-day
    passes:
    - vert: grade-vs:vert
      frag: cloud-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState:
        depthTest: true
        depthWrite: true
  - name: sky-dither
    passes:
    - vert: grade-vs:vert
      frag: sky-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState:
        depthTest: true
        depthWrite: false
  - name: horizon-day
    passes:
    - vert: horizon-vs:vert
      frag: horizon-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
  - name: card-day
    passes:
    - vert: card-vs:vert
      frag: card-fs:frag
      properties:
        mainTexture: { value: white }
      rasterizerState: { cullMode: none }
      depthStencilState:
        depthTest: true
        depthWrite: true
}%

CCProgram grade-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec4 a_color;
  out vec3 v_color;
  vec4 vert () {
    v_color = a_color.rgb;
    return cc_matViewProj * cc_matWorld * vec4(a_position, 1.0);
  }
}%

CCProgram cloud-fs %{
  precision highp float;
  in vec3 v_color;
  // Floor shade is a narrow band around 0.82. Keep the dark majority on the far-card
  // skirt blue (171,216,236) so cloud gaps read as sea. Only the bright tail goes white.
  vec4 frag () {
    float l = dot(v_color, vec3(0.30, 0.59, 0.11));
    vec3 deep = vec3(0.510, 0.639, 0.761);
    vec3 sea = vec3(0.635, 0.725, 0.820);
    float shade = clamp((l - 0.70) / 0.14, 0.0, 1.0);
    vec3 base = mix(deep, sea, shade);
    float u = clamp((l - 0.84) / 0.08, 0.0, 1.0);
    u = u * u * (3.0 - 2.0 * u);
    vec3 c = mix(base, vec3(1.0), u);
    return vec4(c, 1.0);
  }
}%

CCProgram sky-fs %{
  precision highp float;
  in vec3 v_color;
  // Break 8-bit bands on the coarse sky-dome rings. ±2.5/255 is below a contour, above a flat step.
  float ign (vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
  }
  vec4 frag () {
    float l = dot(v_color, vec3(0.30, 0.59, 0.11));
    // Zenith (l≈0.21, board/city) stays. Cruise looks into the brighter ring; lift that
    // ring toward a light horizon so the cloud line is not a dark-teal cut.
    float h = smoothstep(0.22, 0.52, l);
    vec3 c = mix(v_color, vec3(0.55, 0.78, 0.86), h * 0.88);
    c += (ign(gl_FragCoord.xy) - 0.5) * (2.5 / 255.0);
    return vec4(clamp(c, 0.0, 1.0), 1.0);
  }
}%

CCProgram horizon-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec4 a_color;
  out vec3 v_color;
  out float v_y;
  vec4 vert () {
    v_color = a_color.rgb;
    v_y = a_position.y;
    return cc_matViewProj * cc_matWorld * vec4(a_position, 1.0);
  }
}%

CCProgram horizon-fs %{
  precision highp float;
  in vec3 v_color;
  in float v_y;
  // Far clouds: bright haze at the base, white on the lit tops, alpha falling with height
  // so the skyline feathers into the dome instead of a hard cut.
  vec4 frag () {
    float l = dot(v_color, vec3(0.30, 0.59, 0.11));
    float cloud = smoothstep(0.72, 0.96, l);
    vec3 c = mix(vec3(0.62, 0.80, 0.88), vec3(1.0), cloud);
    float h = clamp((v_y - 18.0) / 100.0, 0.0, 1.0);
    float a = 1.0 - smoothstep(0.15, 0.72, h);
    a = max(a, cloud * 0.28);
    return vec4(c, a);
  }
}%

CCProgram card-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec2 a_texCoord;
  out vec2 v_uv;
  vec4 vert () {
    v_uv = a_texCoord;
    return cc_matViewProj * cc_matWorld * vec4(a_position, 1.0);
  }
}%

CCProgram card-fs %{
  precision highp float;
  in vec2 v_uv;
  uniform sampler2D mainTexture;
  // builtin-unlit fogs this card, so its skirt reads as a grey plate on the unfogged sea.
  // Write the albedo in the same raw sRGB space as the sea, and pin skirt pixels to that sea.
  vec4 frag () {
    vec3 tex = texture(mainTexture, v_uv).rgb;
    float skirt = smoothstep(0.05, 0.12, tex.b - tex.r);
    vec3 sea = vec3(0.635, 0.725, 0.820);
    // Stray grass strips sit on the near edge of the card and read as meadow debris in the cloud sea.
    float grass = step(0.08, tex.g - tex.r) * step(0.04, tex.g - tex.b) * step(tex.r, 0.62);
    float debris = grass * (1.0 - smoothstep(0.28, 0.42, v_uv.y));
    tex = mix(tex, sea, debris);
    return vec4(mix(tex, sea, skirt), 1.0);
  }
}%

+// Glass sign v4-refined3.2 (运镜bot): capsule glass card + refined2 rim + top highlight with 15 % faded ends.
+// Edge anti-aliasing is analytic in this shader (SDF + screen-space derivatives); no MSAA/FXAA dependency.
+// Geometry is one quad; a_texCoord carries sign-local px (card = 280x100, y down, same space as the CSS prototype).
+// Output is premultiplied sRGB (the forward RT here is sRGB-ready, like meadow-grass-wind / warm-button-lit).
+CCEffect %{
+  techniques:
+  - name: transparent
+    passes:
+    - vert: glass-sign-vs:vert
+      frag: glass-sign-fs:frag
+      properties:
+        params0: { value: [0.43, 2.4, 2.6, 1.0] }
+        params1: { value: [1.0, 0.0, -1.0, 0.0] }
+        params2: { value: [0.0, 0.0, 0.35, 2.0] }
+      rasterizerState: { cullMode: none }
+      depthStencilState: { depthTest: false, depthWrite: false } # prototype is an overlay: the card sits at the wall plane, never z-fight it
+      blendState:
+        targets:
+        - blend: true
+          blendSrc: one
+          blendDst: one_minus_src_alpha
+          blendSrcAlpha: one
+          blendDstAlpha: one_minus_src_alpha
+}%
+CCProgram glass-sign-vs %{
+  precision highp float;
+  #include <builtin/uniforms/cc-global>
+  #include <builtin/uniforms/cc-local>
+  in vec3 a_position;
+  in vec2 a_texCoord;
+  out vec2 v_px;
+  vec4 vert () {
+    v_px = a_texCoord;
+    return cc_matViewProj * cc_matWorld * vec4(a_position, 1.0);
+  }
+}%
+CCProgram glass-sign-fs %{
+  precision highp float;
+  #pragma extension([GL_OES_standard_derivatives, __VERSION__ < 300])
+  in vec2 v_px;
+  // params0: rim alpha (0.43 r^0.6), top-line width (device px), rim width (device px), group opacity
+  // params1: card scale, ring glow g, ripple progress (<0 off), ring spread k
+  // params2: ripple opacity, unused, local px per device px (fallback without derivatives), dpr
+  uniform GlassSign { vec4 params0; vec4 params1; vec4 params2; };
+  const vec2 C = vec2(140.0, 50.0);
+  float sdCapsule (vec2 p, vec2 halfSize, float r) {
+    vec2 q = abs(p - C) - halfSize + vec2(r);
+    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
+  }
+  float phi (float x) { return 1.0 / (1.0 + exp(1.702 * x)); } // ~ gaussian CDF of -x (x in sigmas)
+  vec4 over (vec4 top, vec4 under) { return top + under * (1.0 - top.a); }
+  float topLineDist (vec2 q) { // open highlight: inset 2.2 along the top, arcs end 0.9*90 deg down each side
+    float R = 47.8;
+    if (q.x >= 50.0 && q.x <= 230.0) return abs(q.y - 2.2) + max(q.y - 50.0, 0.0) * 4.0;
+    vec2 c = vec2(q.x < 50.0 ? 50.0 : 230.0, 50.0);
+    vec2 v = q - c;
+    float a = atan(v.y, v.x);                       // y down: top of the arc is -pi/2
+    float lo = q.x < 50.0 ? -3.14159265 + 0.15707963 : -1.5707963;
+    float hi = q.x < 50.0 ? -1.5707963 : -0.15707963;
+    if (q.x < 50.0 && a > 0.0) a = -3.14159265;     // lower-left: clamp toward the start of the arc
+    a = clamp(a, lo, hi);
+    return length(q - (c + R * vec2(cos(a), sin(a))));
+  }
+  vec4 frag () {
+    float sc = params1.x;
+    vec2 p = v_px;
+    vec2 q = C + (p - C) / sc;                      // card (scaled by tap feedback about its centre)
+    float dq = sdCapsule(q, vec2(140.0, 50.0), 50.0);
+    float d0 = sdCapsule(p, vec2(140.0, 50.0), 50.0);
+  #if __VERSION__ >= 300 || defined(GL_OES_standard_derivatives)
+    float g = max(length(vec2(dFdx(dq), dFdy(dq))), 1e-4);  // sign-local px per device px
+    float g0 = max(length(vec2(dFdx(d0), dFdy(d0))), 1e-4);
+    float w = fwidth(dq) * 0.75;
+  #else
+    float g = params2.z / sc, g0 = params2.z, w = params2.z * 0.75;
+  #endif
+    vec4 col = vec4(0.0);
+    // drop shadow (.shadow layer, not scaled): 0 10px 24px rgba(0,0,0,.22), drawn outside the box only
+    float ds = sdCapsule(p - vec2(0.0, 10.0), vec2(140.0, 50.0), 50.0);
+    float sh = 0.22 * phi(ds / 12.0) * clamp(d0 / g0 + 0.5, 0.0, 1.0);
+    col = over(vec4(0.0, 0.0, 0.0, sh), col);
+    // tap ripple: 3px white border, scale(1+.9e, 1+1.6e)
+    if (params1.z >= 0.0) {
+      float e = 1.0 - pow(1.0 - params1.z, 3.0);
+      vec2 s2 = vec2(1.0 + 0.9 * e, 1.0 + 1.6 * e);
+      vec2 qr = C + (p - C) / s2;
+      float dr = sdCapsule(qr, vec2(140.0, 50.0), 50.0);
+      float gr = g0 / min(s2.x, s2.y);
+      float band = clamp(0.5 - (dr) / gr, 0.0, 1.0) * clamp(0.5 + (dr + 3.0) / gr, 0.0, 1.0);
+      float a = 0.9 * params2.x * band;
+      col = over(vec4(a, a, a, a), col);
+    }
+    // glass card: 160deg gradient rgba(255,255,255,.34 / .10 @55% / .18) + inset 0 -6px 14px rgba(255,255,255,.12)
+    float cover = 1.0 - smoothstep(-w, w, dq);
+    float t = clamp(dot(q - C, vec2(0.34202, 0.93969)) / 189.76 + 0.5, 0.0, 1.0);
+    float fa = t < 0.55 ? mix(0.34, 0.10, t / 0.55) : mix(0.10, 0.18, (t - 0.55) / 0.45);
+    float glow = 0.12 * (1.0 - phi(sdCapsule(q + vec2(0.0, 6.0), vec2(140.0, 50.0), 50.0) / 7.0));
+    float ca = (fa + glow * (1.0 - fa)) * cover;
+    col = over(vec4(ca, ca, ca, ca), col);
+    // ring (inset -4px, r54, 4px border rgba(255,248,220,g)) + glow 0 0 (24+16k)px (6+6k)px rgba(255,236,180,.85g)
+    if (params1.y > 0.0) {
+      float d4 = sdCapsule(p, vec2(144.0, 54.0), 54.0);
+      float k = params1.w, sig = (24.0 + 16.0 * k) * 0.5, spr = 6.0 + 6.0 * k;
+      float gl = 0.85 * params1.y * phi((d4 - spr) / sig) * clamp(d4 / g0 + 0.5, 0.0, 1.0);
+      col = over(vec4(vec3(1.0, 0.925, 0.706) * gl, gl), col);
+      float br = params1.y * clamp(0.5 - d4 / g0, 0.0, 1.0) * clamp(0.5 + (d4 + 4.0) / g0, 0.0, 1.0);
+      col = over(vec4(vec3(1.0, 0.973, 0.863) * br, br), col);
+    }
+    // refined2 rim: capsule inset 0.75 local px, params0.z device px wide, white params0.x
+    float rd = abs(dq + 0.75) / g;
+    float rim = params0.x * clamp(params0.z * 0.5 + 0.5 - rd, 0.0, 1.0);
+    // refined3.1/3.2 top highlight: inset 2.2, round caps, white .8, ends fade 0 -> .8 over 15 % of the chord
+    float td = topLineDist(q) / g;
+    float u = clamp((q.x - 2.79) / 274.42, 0.0, 1.0);
+    float fade = min(min(u / 0.15, (1.0 - u) / 0.15), 1.0);
+    float top = 0.8 * fade * clamp(params0.y * 0.5 + 0.5 - td, 0.0, 1.0);
+    col = over(vec4(rim, rim, rim, rim), col);
+    col = over(vec4(top, top, top, top), col);
+    return col * params0.w;
+  }
+}%

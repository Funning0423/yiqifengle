diff --git a/tools/exit-footsteps/derive_footsteps.cjs b/tools/exit-footsteps/derive_footsteps.cjs
new file mode 100644
index 0000000..76c378e
--- /dev/null
+++ b/tools/exit-footsteps/derive_footsteps.cjs
@@ -0,0 +1,48 @@
+'use strict';
+/** Voice Bot: derive the footstep data the game uses, offline, from the SHIPPED assets.
+ *  1) Foot plants per clip from the character GLB (region_island/character/...grokbot2.glb): FK of every clip at 480 Hz
+ *     (tools/walk-driver/glb_rig.cjs); per foot the lowest shoe-sole vertex (glb_rig.solePoints: vertices rigid on
+ *     foot.L / foot.R) gives h(t) above the controller root plane (y = 0 of the model: the floor the game stands her on; every walk clip's
+ *     lowest sole is within 0.3 mm of it). A plant (heel strike) is the first sample where h <= 4 mm
+ *     after a swing that lifted the sole >= 10 mm within the previous 0.7 s. Lifts < 10 mm (pivot shuffles) are not steps.
+ *     Also reported: the vertical-velocity zero crossing (end of the descent) right after the plant.
+ *  2) Ground surface map from tools/exit-footsteps/ground_map.json (ground_map_blender.py on the shipped world GLB).
+ *  Writes creator-build-project/assets/scripts/audio/FootstepData.ts (generated; do not edit by hand).
+ *    node tools/exit-footsteps/derive_footsteps.cjs [--check]   (--check: fail if the committed file differs) */
+const fs=require('fs'),path=require('path'),crypto=require('crypto');
+const ROOT=path.resolve(__dirname,'..','..'),G=require('../walk-driver/glb_rig.cjs');
+const GLB=path.join(ROOT,'creator-build-project/assets/bundles/region_island/character/chr_b_r5g2_lod0_anim_pass2_INTERIM_s1_grokbot2.glb');
+const OUT=path.join(ROOT,'creator-build-project/assets/scripts/audio/FootstepData.ts');
+const HZ=480,ON_M=0.004,LIFT_M=0.010,LOOKBACK_S=0.7;
+const sha=f=>crypto.createHash('sha256').update(fs.readFileSync(f)).digest('hex');
+function clipPlants(){const rig=G.loadRig(GLB),soles=G.solePoints(GLB),out={},curves={};
+  for(const name of Object.keys(rig.clips).sort()){const c=rig.clips[name],D=c.duration,N=Math.round(D*HZ),h={'foot.L':[],'foot.R':[]};
+    for(let i=0;i<=N;i++){rig.nodes.forEach((n,k)=>{const r=rig.rest[k];n.setPosition(r.p.x,r.p.y,r.p.z);n.setRotation(r.r.x,r.r.y,r.r.z,r.r.w);n.setScale(r.s.x,r.s.y,r.s.z);});G.applyClip(c,i/HZ);
+      for(const b of ['foot.L','foot.R']){let lo=Infinity;for(const p of G.soleWorld(rig.byName(b),soles[b],[0,0,0],0))lo=Math.min(lo,p[1]);h[b].push(lo);}}
+    const lowAt=(b,i)=>{rig.nodes.forEach((n,k)=>{const r=rig.rest[k];n.setPosition(r.p.x,r.p.y,r.p.z);n.setRotation(r.r.x,r.r.y,r.r.z,r.r.w);n.setScale(r.s.x,r.s.y,r.s.z);});G.applyClip(c,i/HZ);let lo=null;for(const p of G.soleWorld(rig.byName(b),soles[b],[0,0,0],0))if(!lo||p[1]<lo[1])lo=p;return lo;};
+    const list=[];for(const b of ['foot.L','foot.R']){const y=h[b],g=0;
+      for(let i=1;i<y.length;i++){if(!(y[i]<=g+ON_M&&y[i-1]>g+ON_M))continue;let pk=0;for(let k=Math.max(0,i-Math.round(LOOKBACK_S*HZ));k<i;k++)pk=Math.max(pk,y[k]-g);if(pk<LIFT_M)continue;
+        let j=i;while(j+1<y.length&&y[j+1]<y[j])j++;const lo=lowAt(b,i);list.push({t:+(i/HZ).toFixed(4),bone:b,x:+lo[0].toFixed(3),z:+lo[2].toFixed(3),liftMm:+(pk*1000).toFixed(1),settleT:+(j/HZ).toFixed(4)});}}
+    list.sort((a,b)=>a.t-b.t);if(list.length)out[name]=list;curves[name]={duration:D};}
+  return {plants:out,curves};}
+function build(){const {plants}=clipPlants(),map=JSON.parse(fs.readFileSync(path.join(__dirname,'ground_map.json'),'utf8'));
+  const worldGlb=path.join(ROOT,'creator-build-project/assets',map.glb.replace(/^assets\//,''));
+  if(fs.existsSync(worldGlb)&&sha(worldGlb)!==map.glbSHA256)throw Error('ground_map.json is stale: re-run ground_map_blender.py on '+map.glb);
+  const rle=r=>{let o='',i=0;while(i<r.length){let j=i;while(j<r.length&&r[j]===r[i])j++;o+=(j-i>1?(j-i):'')+r[i];i=j;}return o;};
+  const clips={};for(const k of Object.keys(plants))clips[k]=plants[k].map(p=>({t:p.t,bone:p.bone,x:p.x,z:p.z}));
+  const src=`/** GENERATED by tools/exit-footsteps/derive_footsteps.cjs (Voice Bot). Do not edit by hand; re-run the tool.
+ *  FOOTSTEP_PLANTS: heel-strike (foot plant) times in CLIP seconds per character clip, from the shipped GLB's shoe soles
+ *  (first sample within ${ON_M*1000} mm of the root plane after a >= ${LIFT_M*1000} mm lift; FK at ${HZ} Hz), and x/z = where that sole
+ *  touches, in the character's model frame (+z forward, metres). Fired by FootstepCore.FootstepTracker, which observes the
+ *  motion clock from outside (FlowReferenceStandin / CharacterMotion / anim_meta stay frozen).
+ *  FOOTSTEP_GROUND: ${map.cell} m surface grid of the home/island ground (ground_map_blender.py on the shipped world GLB),
+ *  rows = z from z0, columns = x from x0, run-length encoded. W wood, R rug, S stone, P path, G grass, . none. */
+export const FOOTSTEP_PLANTS: { glbSHA256: string; clips: { [clip: string]: ReadonlyArray<{ t: number; bone: 'foot.L' | 'foot.R'; x: number; z: number }> } } = ${JSON.stringify({glbSHA256:sha(GLB),clips},null,1).replace(/\n\s*/g,' ')};
+export const FOOTSTEP_GROUND = { glbSHA256: '${map.glbSHA256}', x0: ${map.x0}, z0: ${map.z0}, cell: ${map.cell}, nx: ${map.nx}, nz: ${map.nz},
+  rows: ${JSON.stringify(map.rows.map(rle))} } as const;
+`;return {src,plants};}
+module.exports={clipPlants,build,GLB,OUT,ON_M,LIFT_M,HZ};
+if(require.main===module){const {src,plants}=build();
+  if(process.argv.includes('--check')){const cur=fs.existsSync(OUT)?fs.readFileSync(OUT,'utf8'):'';if(cur!==src){console.error('FootstepData.ts is stale; run node tools/exit-footsteps/derive_footsteps.cjs');process.exit(1);}console.log('FootstepData.ts up to date');}
+  else{fs.writeFileSync(OUT,src);console.log('wrote',path.relative(ROOT,OUT));}
+  for(const k of Object.keys(plants))console.log(k,plants[k].map(p=>p.bone.slice(-1)+'@'+p.t+'(lift '+p.liftMm+' mm, settle '+p.settleT+')').join('  '));}

@@ -43,7 +43,7 @@ t('ordering: prewarm runs on the first show(true) right after prime(), under the
  assert.match(prep,/const warmWater=\(\)=>\{if\(warm\|\|dead\|\|!journeyWater\)return;warm=prewarmLakesideWaterDraw\(camera,journeyWater,lakesideWaterSourceRenderer\(lakeModel,isLakesideWaterNode\)\);\};/);
  assert.match(prep,/useLakesideWater\(model,water\);[\s\S]{0,200}journeyWater=water;\}/,'the journey copy, after it is on the lake');
  assert.doesNotMatch(prep.slice(prep.indexOf('progress(d)')),/warmWater\(\)/,'not from the walk');
- assert.match(prep,/const release=\(\)=>\{if\(dead\)return;dead=true;offWater\(\);atmosphere\.restore\(\);releaseLakesideBoardPreload\(\)[^;]*;warm\?\.cancel\(\)/);
+ assert.match(prep,/const release=\(\)=>\{if\(dead\)return;dead=true;offWater\(\);(offLand\(\);)?atmosphere\.restore\(\);releaseLakesideBoardPreload\(\)[^;]*;warm\?\.cancel\(\)/);
  const black=core.indexOf("this.fadeState='black'"),show=core.indexOf('this.show(true);',black),fadeIn=core.indexOf("this.fadeState='in'",black);
  assert(black>0&&show>black&&fadeIn>show,'show(true) happens under full black, before the fade-in');});
 (async()=>{let fail=0;for(const [n,f] of tests){try{await f();console.log('PASS',n);}catch(e){fail++;console.log('FAIL',n,'\n',e.stack||e);}}
diff --git a/tools/lakeside/test_lakeside_land_fill.cjs b/tools/lakeside/test_lakeside_land_fill.cjs
index 516a1e4..df8c4bd 100644
--- a/tools/lakeside/test_lakeside_land_fill.cjs
+++ b/tools/lakeside/test_lakeside_land_fill.cjs
@@ -55,4 +55,8 @@ run('day/night writer: night values on land only; water material and bridge unto
  assert.match(ad,/offLand=onDayNightChange\(\(\)=>\{if\(!dead\)applyLakesideLandFill\(model,lakesideDayNightMode\(\)\);\}\);/);assert.match(ad,/dead=true;offWater\(\);offLand\(\);/);});
 run('night land fill is cool and small (no brown)',()=>{const N=D.lakesideModeLighting('night'),Dy=D.lakesideModeLighting('day');
  for(const k of ['landFillNearLinear','landFillFarLinear']){const c=N[k];assert(c[2]>=c[1]&&c[1]>=c[0]&&c[2]>c[0],'night '+k+' blue >= green >= red');assert(Math.max(...c)<Math.max(...Dy[k])*0.5,'night '+k+' far below day');}});
+run('skyDomeColorSrgb = the clear colour per mode (not the reflected-sky inputs)',()=>{for(const m of ['day','night']){const L=D.lakesideModeLighting(m);
+ assert.equal(L.skyDomeColorSrgb,L.clearColor,m+' sky dome = clear colour');}
+ assert.equal(D.lakesideModeLighting('day').skyDomeColorSrgb,D.lakesideDayClearColor());assert.equal(D.lakesideModeLighting('night').skyDomeColorSrgb,D.LAKESIDE_NIGHT_LIGHT_PARAMS.clearColor);
+ const sd=fs.readFileSync(S+'LakesideSceneData.ts','utf8');assert.equal((sd.match(/skyDomeColorSrgb\s*:\s*['"#]/g)||[]).length,0,'skyDomeColorSrgb is derived from the clear colour, never a literal');});
 console.log('lakeside land fill OK');
diff --git a/tools/test_es5_iterator_spread.cjs b/tools/test_es5_iterator_spread.cjs

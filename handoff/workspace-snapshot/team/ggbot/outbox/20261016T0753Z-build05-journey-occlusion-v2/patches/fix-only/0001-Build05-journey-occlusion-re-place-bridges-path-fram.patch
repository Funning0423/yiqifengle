+#!/usr/bin/env node
+'use strict';
+/* Rebuilds fixture-occluders.bin.gz + fixture-occluders.json from the bundled region GLBs.
+ * Draco GLBs must first be decoded with Blender (decode-draco-blender.py); meadow is read directly by the test.
+ * Usage: node build-fixture.cjs <decoded-dir>  (expects room.glb, palm_tall.glb, palm_short.glb, skycity.glb)
+ * Only geometry inside generous model-space boxes around the two bridges is kept, so the fixture stays small.
+ * The source GLB SHA-256 is recorded; the test refuses to run on art that no longer matches. */
+const fs=require('node:fs'),path=require('node:path'),zlib=require('node:zlib'),crypto=require('node:crypto');
+const {load}=require('./lib-glb.cjs');
+const ROOT=path.resolve(__dirname,'../../..'),B=ROOT+'/creator-build-project/assets/bundles/',dir=process.argv[2];if(!dir)throw Error('usage: build-fixture.cjs <decoded-dir>');
+const sha=f=>crypto.createHash('sha256').update(fs.readFileSync(f)).digest('hex');
+// Model-space keep boxes [min,max]. Island: everything outdoors around the exit path and the start-camera swing.
+// Sky: 45 m around the cloud-bridge end anchor (deck, post, rim, rock strata, ruins). Skinned robot excluded (animated at the court).
+const SOURCES=[
+ {id:'island',glb:'static_seat_preview/room/room_no_original_chair.glb',decoded:'room.glb',box:[[-20,-3,-6],[20,22,52]],skip:/^env_interior_|^env_int_|^env_sea_|^env_cloud_layer/},
+ {id:'palm_tall',glb:'region_island/ui-props/beach_palm_tall.glb',decoded:'palm_tall.glb',box:null,skip:null},
+ {id:'palm_short',glb:'region_island/ui-props/beach_palm_short.glb',decoded:'palm_short.glb',box:null,skip:null},
+ {id:'skycity',glb:'region_skycity/env_skycity.glb',decoded:'skycity.glb',box:[[-90,-25,20],[0,30,105]],skip:/^chr_robot|cloudsea|cumulus|islets_far|cloud_small|env_sky_birds|greattree_canopy|starring|ring_|pennant|waterfall/},
+];
+const inBox=(t,k,[a,b])=>{for(const o of [0,3,6]){const x=t[k+o],y=t[k+o+1],z=t[k+o+2];if(x>=a[0]&&x<=b[0]&&y>=a[1]&&y<=b[1]&&z>=a[2]&&z<=b[2])return true;}return false;};

+// 风铃湖畔 water (GGbot D1 v3). Cheap mobile water for WeChat WebGL1/2: lit like builtin-standard's diffuse terms
+// (vertex colour x waterTint), Fresnel blend to the r5h3 sky colour at grazing angles, a Blinn-Phong sunset streak from the
+// main DirectionalLight, optional sin-wave normal (cc_time). No textures, no render targets, scene fog applied. Instancing via local-batch.
+CCEffect %{
+  techniques:
+  - name: opaque
+    passes:
+    - vert: lk-water-vs:vert
+      frag: lk-water-fs:frag
+      properties:
+        waterTint:     { value: [0.06, 0.55, 1.0, 1.0], linear: true, editor: { type: color } }
+        skyZenith:     { value: [0.0116, 0.2747, 0.4793, 1.0], linear: true, editor: { type: color } }
+        skyLow:        { value: [0.9216, 0.5776, 0.2705, 1.0], linear: true, editor: { type: color } }
+        skyHorizon:    { value: [1.0, 0.5457, 0.1441, 1.0], linear: true, editor: { type: color } }
+        fresnelParams: { value: [5.0, 0.02, 0.85, 1.0], editor: { tooltip: 'x power, y F0, z max mix, w sky strength' } }
+        specParams:    { value: [300.0, 1.6, 0.4, 0.0], editor: { tooltip: 'x Blinn exponent, y intensity, z exponent noise' } }
+        waveParams:    { value: [0.06, 0.9, 0.7, 0.0], editor: { tooltip: 'x normal tilt, y freq (1/m), z speed, w unused' } }
+}%
+
+CCProgram lk-water-vs %{
+  precision highp float;
+  #include <legacy/input-standard>
+  #include <builtin/uniforms/cc-global>
+  #include <legacy/local-batch>
+  #include <legacy/fog-vs>
+
+  #if USE_VERTEX_COLOR
+    in lowp vec4 a_color;
+    out lowp vec4 v_color;
+  #endif
+  out vec3 v_worldPos;
+  out vec3 v_worldNormal;
+
+  vec4 vert () {
+    StandardVertInput In;
+    CCVertInput(In);
+    mat4 matWorld, matWorldIT;
+    CCGetWorldMatrixFull(matWorld, matWorldIT);
+    vec4 pos = matWorld * In.position;
+    v_worldPos = pos.xyz;
+    v_worldNormal = normalize((matWorldIT * vec4(In.normal, 0.0)).xyz);
+    #if USE_VERTEX_COLOR
+      v_color = a_color;
+    #endif
+    CC_TRANSFER_FOG(pos);
+    return cc_matProj * (cc_matView * pos);
+  }
+}%
+
+CCProgram lk-water-fs %{
+  precision highp float;
+  #include <builtin/uniforms/cc-global>
+  #include <legacy/output-standard>
+  #include <legacy/fog-fs>
+
+  in vec3 v_worldPos;
+  in vec3 v_worldNormal;
+  #if USE_VERTEX_COLOR
+    in lowp vec4 v_color;
+  #endif
+
+  uniform LakesideWater {
+    vec4 waterTint;
+    vec4 skyZenith;
+    vec4 skyLow;
+    vec4 skyHorizon;
+    vec4 fresnelParams;
+    vec4 specParams;
+    vec4 waveParams;
+  };
+
+  vec4 frag () {
+    vec3 N = normalize(v_worldNormal);
+    #if USE_WAVES
+      float t = cc_time.x * waveParams.z, f = waveParams.y;
+      vec2 p = v_worldPos.xz * f;
+      vec2 d = vec2(sin(p.x + t) + 0.5 * sin(1.7 * p.y - 1.3 * t), cos(p.y + 0.8 * t) + 0.5 * cos(1.3 * p.x + 1.1 * t));
+      N = normalize(N + vec3(d.x, 0.0, d.y) * waveParams.x);
+    #endif
+    vec3 V = normalize(cc_cameraPos.xyz - v_worldPos);
+    vec3 L = normalize(-cc_mainLitDir.xyz);
+    vec3 albedo = waterTint.rgb;
+    #if USE_VERTEX_COLOR
+      albedo *= SRGBToLinear(v_color.rgb);
+    #endif
+    // Diffuse: the same terms as legacy/shading-standard-base (direct NL/PI + hemispheric ambient), so it sits with the palette props.
+    float NL = max(dot(N, L), 0.0);
+    vec3 lit = cc_mainLitColor.rgb * cc_mainLitColor.w;
+    float fAmb = max(0.0001, 0.5 - N.y * 0.5);
+    vec3 amb = mix(cc_ambientSky.rgb, cc_ambientGround.rgb, fAmb) * cc_ambientSky.w;
+    vec3 col = albedo * (lit * NL / 3.14159265 + amb);
+    // Fresnel sky reflection (Schlick): water colour at normal incidence -> sky blue / horizon at grazing angles.
+    float NV = clamp(dot(N, V), 0.0, 1.0);
+    float F = fresnelParams.y + (1.0 - fresnelParams.y) * pow(1.0 - NV, fresnelParams.x);
+    // Reflected sky = the r5h3 world ramp by reflection elevation: horizon (<=0) -> low sky (0.16) -> zenith (>=0.38).
+    vec3 R = reflect(-V, N);
+    float e = R.y;
+    vec3 sky = mix(skyHorizon.rgb, skyLow.rgb, smoothstep(0.0, 0.16, e));
+    sky = mix(sky, skyZenith.rgb, smoothstep(0.16, 0.38, e)) * cc_ambientSky.w * fresnelParams.w;
+    col = mix(col, sky, clamp(F, 0.0, fresnelParams.z));
+    // Sunset streak: Blinn-Phong from the main light, its colour and intensity.
+    vec3 H = normalize(L + V);
+    // Streak: exponent wobbles +-specParams.z along x so the highlight breaks into a sunset band (cheap sin noise, no texture).
+    float n = 0.5 + 0.5 * sin(v_worldPos.x * 3.1 + sin(v_worldPos.z * 1.7 + cc_time.x * 0.6) * 2.0);
+    float ex = specParams.x * (1.0 + specParams.z * (n - 0.5) * 2.0);
+    col += lit * pow(max(dot(N, H), 0.0), ex) * specParams.y * F;
+    vec4 o = vec4(col, 1.0);
+    CC_APPLY_FOG(o, v_worldPos);
+    return CCFragOutput(o);
+  }
+}%

+ const w=Math.max(0,Math.min(1,Number.isFinite(weight)?weight:0)),t=lakesideAtmosphereTarget(base),P=LAKESIDE_DIR_LIGHT_PARAMS,L=LAKESIDE_LAYERED_FOG,A=LAKESIDE_JOURNEY_ATMOSPHERE;

+const SEM=['POSITION','NORMAL','TEXCOORD_0','COLOR_0'],att=Object.fromEntries(SEM.map(k=>[k,Array.from(p.getAttribute(k).getArray())])),sz=Object.fromEntries(SEM.map(k=>[k,p.getAttribute(k).getElementSize()]));

 tools/voice-bot/bgm/test_scene_bgm.cjs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/voice-bot/bgm/test_scene_bgm.cjs b/tools/voice-bot/bgm/test_scene_bgm.cjs
index aeeb561..3e2510c 100644
--- a/tools/voice-bot/bgm/test_scene_bgm.cjs
+++ b/tools/voice-bot/bgm/test_scene_bgm.cjs
@@ -323,7 +323,7 @@ for (const order of ['unlock-then-load', 'load-then-unlock', 'unlock-before-room
   ok(dup.length === 0, 'no duplicate uuids across assets/**/*.meta (' + allMetas.length + ' metas)', dup);

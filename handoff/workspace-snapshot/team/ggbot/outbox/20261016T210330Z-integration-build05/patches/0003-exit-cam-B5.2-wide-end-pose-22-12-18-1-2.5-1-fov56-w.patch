       'v23-wide': { position: [-49.6623, 26.7215, 56.2639], target: [-2.1535, -4.5424, 3.7359], fovVerticalDeg: 42, characterYawDeg: 0,
@@ -189,14 +189,14 @@ export const TRANSITION_CAMERA = Object.freeze({

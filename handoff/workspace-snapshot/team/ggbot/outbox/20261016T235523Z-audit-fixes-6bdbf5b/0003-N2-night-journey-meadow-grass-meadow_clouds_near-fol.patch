diff --git a/creator-build-project/assets/bundles/region_meadow/meadow-grass-wind.effect b/creator-build-project/assets/bundles/region_meadow/meadow-grass-wind.effect
index 11eeb46..909d223 100644
--- a/creator-build-project/assets/bundles/region_meadow/meadow-grass-wind.effect
+++ b/creator-build-project/assets/bundles/region_meadow/meadow-grass-wind.effect
@@ -24,7 +24,10 @@ CCProgram meadow-grass-vs %{
     float omega = 6.28318530718 / 4.0;
     float d = a_color.a * 1.5 * r * r * (0.36 * sin(a_texCoord1.y - omega * windParams.x) - 0.26 * sin(omega * windParams.x));
     vec3 p = a_position + vec3(0.944 * d, -0.3 * d * r, -0.330 * d);
-    v_color = a_color.rgb * mix(vec3(1.0), vec3(0.50, 0.62, 0.70), windParams.z);
+    // z = night weight. w = 1 on the region journey: use the world's lit-night grade
+    // (DayNight lightScale 0.35 x moon colour [180,198,232] linearised) instead of the board's softer sea tint.
+    vec3 nightK = mix(vec3(0.50, 0.62, 0.70), vec3(0.16, 0.20, 0.28), windParams.w);
+    v_color = a_color.rgb * mix(vec3(1.0), nightK, windParams.z);
     return cc_matViewProj * cc_matWorld * vec4(p, 1.0);
   }
 }%

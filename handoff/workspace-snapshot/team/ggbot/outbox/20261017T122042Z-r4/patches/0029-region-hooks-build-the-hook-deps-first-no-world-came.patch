---
 .../assets/scripts/world-r2/WorldNativeComposition.ts           | 2 +-
 tools/journey-integration/test-region-landing-hook.cjs          | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/creator-build-project/assets/scripts/world-r2/WorldNativeComposition.ts b/creator-build-project/assets/scripts/world-r2/WorldNativeComposition.ts
index 8c86179..378138c 100644
--- a/creator-build-project/assets/scripts/world-r2/WorldNativeComposition.ts
+++ b/creator-build-project/assets/scripts/world-r2/WorldNativeComposition.ts
@@ -86,7 +86,7 @@ export class WorldNativeComposition extends Component {
     if(region==='lakeside'){const landed=await lakesideLandingToBoard({stageId:selection.stageId,journey:this.world?.commands().snapshot().journey??null,deps:this.lakesideLandingDeps()});if(landed?.ok===false)return this.lakesideFallback('board',landed.reason);held=true;this.world?.holdEnterLevel?.(true);}
     // 运镜bot (region hooks): 04→05 / 08→09 end on the meadow / skycity board camera (RegionBoardLanding); hold the push-in only
     // when the hook put the world camera ON that pose and that board background will render. Otherwise today's path, unchanged.
-    else if((region==='meadow'&&requiresMeadowScene(selection))||(region==='skycity'&&requiresSkycityScene(selection))){const landed=await regionLandingToBoard({region,stageId:selection.stageId,deps:this.regionLandingDeps(region)});if(landed.ok){held=true;this.world?.holdEnterLevel?.(true);}}
+    else if(region==='meadow'||region==='skycity'){const deps=this.regionLandingDeps(region);if(deps&&(region==='meadow'?requiresMeadowScene(selection):requiresSkycityScene(selection))){const landed=await regionLandingToBoard({region,stageId:selection.stageId,deps});if(landed.ok){held=true;this.world?.holdEnterLevel?.(true);}}}
     // 运镜bot: the hold is one-shot and only for this enterLevel (the board camera = the landing end, no push-in, no cut back).
     let result:Result;try{result=await this.world.commands().enterLevel(selection.stageId);}finally{if(held)this.world?.holdEnterLevel?.(false);}if(result.ok)this.pendingJourneySelection=null;
     // v3.3: a failed lakeside scene already logged its cause ([QF_LAKESIDE]); lakesideFallback puts her back on the island. Hand the HUD one stable reason.
diff --git a/tools/journey-integration/test-region-landing-hook.cjs b/tools/journey-integration/test-region-landing-hook.cjs
index cca7273..4d59688 100644
--- a/tools/journey-integration/test-region-landing-hook.cjs
+++ b/tools/journey-integration/test-region-landing-hook.cjs
@@ -90,7 +90,7 @@ await T('wiring',async()=>{const src=f=>fs.readFileSync(S+f,'utf8').replace(/\s+
  ok(/board=regionBoardEnd\(boardSrc,v\.width\/v\.height\)/.test(ad)&&/lakesideViewport\(view\.getFrameSize\(\)\)/.test(ad),'adapter: route.board from the board UI viewport');
  ok(/\.\.\.\(board\?\{board\}:\{\}\)\};/.test(ad),'adapter: route carries board');
  ok(/if\(boardSrc&&route\.board\)setRegionBoardSource\(to as BoardLandingRegion,boardSrc\);/.test(ad)&&/if\(boardSrc&&regionBoardSource\(to as BoardLandingRegion\)===boardSrc\)setRegionBoardSource\(to as BoardLandingRegion,null\);/.test(ad),'adapter: map registered / dropped with the lease');
- ok(/else if\(\(region==='meadow'&&requiresMeadowScene\(selection\)\)\|\|\(region==='skycity'&&requiresSkycityScene\(selection\)\)\)\{const landed=await regionLandingToBoard\(\{region,stageId:selection\.stageId,deps:this\.regionLandingDeps\(region\)\}\);if\(landed\.ok\)\{held=true;this\.world\?\.holdEnterLevel\?\.\(true\);\}\}/.test(co),'composition: hold only on ok, only with that background');
+ ok(/else if\(region==='meadow'\|\|region==='skycity'\)\{const deps=this\.regionLandingDeps\(region\);if\(deps&&\(region==='meadow'\?requiresMeadowScene\(selection\):requiresSkycityScene\(selection\)\)\)\{const landed=await regionLandingToBoard\(\{region,stageId:selection\.stageId,deps\}\);if\(landed\.ok\)\{held=true;this\.world\?\.holdEnterLevel\?\.\(true\);\}\}\}/.test(co),'composition: hold only on ok, only with that background (no world camera → today\'s path)');
  ok(/finally\{if\(held\)this\.world\?\.holdEnterLevel\?\.\(false\);\}/.test(co),'composition: hold cleared');
  ok(/const pose=meadowScenePose\(layout\.width\/layout\.height\);if\(!applyCameraPose\(camera!,fromLookAt\(pose\)/.test(mb),'meadow background still writes meadowScenePose(aspect)');
  ok(/pose=skycityVisitPose\(\[av\.x,av\.y,av\.z\],\[bv\.x,bv\.y,bv\.z\],layout\.width\/layout\.height\);if\(!applyCameraPose\(camera!,fromLookAt\(pose\)/.test(sb)&&/find\(model,'anchor_spawn_girl'\),b=find\(model,'anchor_starcourt_center'\)/.test(sb),'skycity background still writes skycityVisitPose(spawn, court, aspect)');

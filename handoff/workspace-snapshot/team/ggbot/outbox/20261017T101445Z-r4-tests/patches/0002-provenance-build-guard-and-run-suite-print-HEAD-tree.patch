 tools/build-guard/build-wechat-guarded.sh | 11 ++++++++---
 tools/build-guard/test_build_guard.sh     |  7 ++++++-
 tools/journey-integration/run-suite.cjs   |  7 +++++--
 4 files changed, 22 insertions(+), 6 deletions(-)


 import {REGIONS, loadRegionPrefab, mountRegion} from './RegionLoader';
 import {RegionAmbientAnimation} from './RegionAmbientAnimation';
 import {SkyNightTexture} from '../render/SkyNightTexture';
-import {configureMeadowVertexColors, loadWindEffect, validateModel, MeadowSceneMotion, meadowCloudMaterials} from './MeadowBoardBackground';
+import {configureMeadowVertexColors, loadWindEffect, validateModel, MeadowSceneMotion, meadowCloudMaterials, meadowGroundMaterials} from './MeadowBoardBackground';
 import {rotate} from '../world-r1/CameraPose';
 import {RegionJourneyController, routeLength} from '../world-r1/RegionJourneyCore';
 import {REGION_JOURNEY_LAYOUT,bridgePath,islandApproach,lensKeys,plus,skyDeckRoute,skycityYawDeg} from './RegionJourneyLayout';
@@ -58,6 +58,7 @@ export function createRegionJourney(options:{parent:Node;camera:Camera}):RegionJ
      motion=rig.addComponent(MeadowSceneMotion);motion.material=material;motion.sail=find(model,'windmill_sail_hub');
      // N2: grass + topmost cloud follow the journey's night grade.
      motion.journeyNight=true;motion.clouds=meadowCloudMaterials(find(model,'meadow_clouds_near'));
+     motion.grounds=meadowGroundMaterials([find(model,'meadow_terrain'),find(model,'meadow_river_bank')]);
     }else{const ambient=model.getComponent(RegionAmbientAnimation);if(!ambient)throw Error('journey-skycity-ambient-missing');await waitRegionAsset(ambient.prepare(),token);token.check();}
     progress(.86);
     let approach:Vec[];
diff --git a/tools/test_meadow_night_grade.cjs b/tools/test_meadow_night_grade.cjs
index a285cab..1af8479 100644
--- a/tools/test_meadow_night_grade.cjs
+++ b/tools/test_meadow_night_grade.cjs
@@ -20,3 +20,15 @@ assert.deepStrictEqual(f(0),[1,1,1]);assert.deepStrictEqual(f(1).map(v=>+v.toFix
 assert(/motion\.journeyNight=true;motion\.clouds=meadowCloudMaterials\(find\(model,'meadow_clouds_near'\)\)/.test(ad),'journey enables grade on meadow_clouds_near');
 assert(!/journeyNight=true/.test(bg),'board background stays on the old grade');
 console.log('meadow night grade OK',want.map(v=>v.toFixed(3)).join(','));
+// N2b: the ground (terrain + river bank) follows the same journey night grade.
+{
+ const g=bg.match(/MEADOW_NIGHT_LINEAR:readonly number\[\]=\[([^\]]+)\]/);assert(g,'ground night constant');
+ g[1].split(',').map(Number).forEach((v,i)=>assert(Math.abs(v-want[i])<.006,'ground grade '+i));
+ const s2l=c=>c<=.04045?c/12.92:Math.pow((c+.055)/1.055,2.4),l2s=c=>c<=.0031308?c*12.92:1.055*Math.pow(c,1/2.4)-.055;
+ const fac=w=>g[1].split(',').map(Number).map(k=>1+(l2s(k)-1)*Math.max(0,Math.min(1,w)));
+ assert.deepStrictEqual(fac(0),[1,1,1]);fac(1).forEach((v,i)=>assert(Math.abs(s2l(v)-want[i])<.006,'ground linear '+i));
+ assert(/export function meadowGroundFactor\(w:number\):number\[\]\{const t=Math\.max\(0,Math\.min\(1,w\)\);return MEADOW_NIGHT_LINEAR\.map\(k=>1\+\(linToSrgb\(k\)-1\)\*t\);\}/.test(bg),'factor formula');
+ assert(/if\(this\.journeyNight\)for\(const g of this\.grounds\)\{const k=meadowGroundFactor\(night\);g\.m\.setProperty\('mainColor'/.test(bg),'motion grades grounds');
+ assert(/motion\.grounds=meadowGroundMaterials\(\[find\(model,'meadow_terrain'\),find\(model,'meadow_river_bank'\)\]\)/.test(ad),'journey wires terrain+bank');
+ console.log('meadow ground night grade OK');
+}

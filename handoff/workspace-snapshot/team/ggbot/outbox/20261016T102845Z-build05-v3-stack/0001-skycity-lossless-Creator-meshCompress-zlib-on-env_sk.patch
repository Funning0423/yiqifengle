From 441792b7ed0aab6c364f32cf21883908e654337a Mon Sep 17 00:00:00 2001
From: GGbot <ggbot@local>
Date: Fri, 16 Oct 2026 18:16:51 +0800
Subject: [PATCH 1/3] skycity: lossless Creator meshCompress (zlib) on
 env_skycity.glb

Step 1 of the region_skycity size work. compress only: no GLB/texture/material change, no engine module change.
Box estimate (meshopt/zlib on the decoded GLB, scaled to the Oct 15 web build bins): meshes 5.08 -> ~1.13 MiB, bundle ~7.63 -> ~3.7 MiB.
encode (needs meshopt module) and quantize (half-float positions) left off pending a Mac visual check.
---
 .../bundles/region_skycity/env_skycity.glb.meta      |  6 ++++++
 tools/skycity/test_skycity_mesh_compress.cjs         | 12 ++++++++++++
 2 files changed, 18 insertions(+)
 create mode 100644 tools/skycity/test_skycity_mesh_compress.cjs

diff --git a/creator-build-project/assets/bundles/region_skycity/env_skycity.glb.meta b/creator-build-project/assets/bundles/region_skycity/env_skycity.glb.meta
index 4983fb5..d84f439 100644
--- a/creator-build-project/assets/bundles/region_skycity/env_skycity.glb.meta
+++ b/creator-build-project/assets/bundles/region_skycity/env_skycity.glb.meta
@@ -1157,6 +1157,12 @@
   },
   "userData": {
     "tangents": 1,
+    "meshCompress": {
+      "enable": true,
+      "compress": true,
+      "encode": false,
+      "quantize": false
+    },
     "imageMetas": [
       {
         "name": "tex_sky_palette_256",
diff --git a/tools/skycity/test_skycity_mesh_compress.cjs b/tools/skycity/test_skycity_mesh_compress.cjs
new file mode 100644
index 0000000..c157e28
--- /dev/null
+++ b/tools/skycity/test_skycity_mesh_compress.cjs
@@ -0,0 +1,12 @@
+#!/usr/bin/env node
+'use strict';
+// Skycity mesh size step 1 (lossless): Creator 3.8.8 glTF importer meshCompress.compress (zlib, inflated at load by the core engine).
+// encode needs the culled engine module "meshopt"; quantize stores RGB16F (half-float) positions = up to 6 cm error on the 75 m palette mesh,
+// so both stay off until a Mac visual check. No GLB, texture or material change.
+const fs=require('fs'),path=require('path'),assert=require('assert');
+const P=path.resolve(__dirname,'../../creator-build-project'),m=JSON.parse(fs.readFileSync(P+'/assets/bundles/region_skycity/env_skycity.glb.meta','utf8'));
+assert.deepStrictEqual(m.userData.meshCompress,{enable:true,compress:true,encode:false,quantize:false});
+assert.equal(m.userData.tangents,1,'tangent import unchanged');
+const eng=JSON.parse(fs.readFileSync(P+'/settings/v2/packages/engine.json','utf8'));
+assert.equal(eng.modules.configs.defaultConfig.cache.meshopt._value,false,'encode stays off while the meshopt module is culled');
+console.log('PASS skycity meshCompress lossless (compress only)');

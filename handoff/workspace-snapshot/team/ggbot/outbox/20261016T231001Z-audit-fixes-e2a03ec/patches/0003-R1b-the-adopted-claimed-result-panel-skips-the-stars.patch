From b7c5221de319b0692dc87b6ca062353314a62b74 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sat, 17 Oct 2026 06:58:47 +0800
Subject: [PATCH 3/6] R1b: the adopted (claimed) result panel skips the stars'
 drop-in; test asserts stars visible on the first repainted frame

---
 creator-build-project/assets/scripts/ui/BoardPanels.ts | 3 ++-
 tools/board-ui/test_result_chest_handoff.cjs           | 4 +++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/creator-build-project/assets/scripts/ui/BoardPanels.ts b/creator-build-project/assets/scripts/ui/BoardPanels.ts
index 323de2c..0813cb1 100644
--- a/creator-build-project/assets/scripts/ui/BoardPanels.ts
+++ b/creator-build-project/assets/scripts/ui/BoardPanels.ts
@@ -132,7 +132,8 @@ export function openResult(stack: PopupStack, m: ResultModel, legacy: ToolArtSou
     button('primary', '返回海岛', 552, 440, 104, m.home, { icon: 'popup/icon_home', fontSize: 36, name: 'Home', sound: 'back' });
   }
   configureResultLayout(p, ph, m, groups, actions, rewards);
-  dropStars(p, starNodes);
+  // R1b: a claim repaint that adopted the live chest shows the stars already landed (no second drop-in).
+  if (!chestAdopted) dropStars(p, starNodes);
   // R1: the claim repaint replaces an already-open panel; it must not replay the 0.22 s pop-in (92% scale, fade from 0,
   // shade from clear) that showed as a small glowing chest for ~3 frames.
   if (chestAdopted) { chestAdopted = false; p.settleOpen(); }
diff --git a/tools/board-ui/test_result_chest_handoff.cjs b/tools/board-ui/test_result_chest_handoff.cjs
index 35f6a6d..899a06c 100644
--- a/tools/board-ui/test_result_chest_handoff.cjs
+++ b/tools/board-ui/test_result_chest_handoff.cjs
@@ -61,7 +61,9 @@ const { createHarness } = require('./harness.cjs');
     const s = activeScore(q.root), a0 = wy(s); assert(Math.abs(a0 - y0) < 0.6, 'R1a: score starts at the tapped y after a double repaint: ' + a0 + ' vs ' + y0);
     q.update(0.025); const a1 = wy(s); settle(20); const a2 = wy(s);
     assert(Math.abs(a2 - y0) > 30, 'harness reproduces the open-state score move'); assert(Math.abs(a1 - a2) > 5, 'R1a: one frame later still easing, not jumped: ' + a1 + ' → ' + a2);
-    out.doubleRepaint = { from: +y0.toFixed(1), frame1: +a1.toFixed(1), to: +a2.toFixed(1) }; stack.clear(); settle();
+    const stars = []; const v = n => { if (/^Star/.test(n.name) && n.activeInHierarchy) stars.push(n); n.children.forEach(v); }; v(q.root);
+    stack.update(0.0); for (const n of stars) { const o = n.getComponent(H.cc.UIOpacity); assert(!o || o.opacity === 255, 'R1b: star ' + n.name + ' visible on the first frame, no re-drop'); }
+    out.doubleRepaint = { from: +y0.toFixed(1), frame1: +a1.toFixed(1), to: +a2.toFixed(1), stars: stars.length }; stack.clear(); settle();
   }
   assert(Math.abs(P.scoreEaseAt(0)) < 1e-9 && P.scoreEaseAt(P.SCORE_EASE_S) === 1 && P.scoreEaseAt(0.1) > 0.4 && P.scoreEaseAt(0.1) < 1);
   console.log(JSON.stringify({ status: 'PASS', ...out }));
-- 

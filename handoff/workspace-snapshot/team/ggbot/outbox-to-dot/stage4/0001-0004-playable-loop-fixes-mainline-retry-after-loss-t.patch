@@ -0,0 +1,35 @@
+import { sys } from 'cc';
+/**
+ * GGbot fix-4 (Funning decision 2026-10-09): every R5 regional challenge stage grants a one-time first-clear reward.
+ * - Ledger key: <R5 namespace>forest-regional-r05-firstclear-v1 (same isolated namespace as R5 saves, survives cold start).
+ * - Reward content reuses the mainline chest table: R5 stage (region, ordinal) -> mainline level regionIndex*4 + ordinal-1,
+ *   read at runtime from the mainline journey snapshot (journey.chests[level].rewards). To change rewards, edit
+ *   rewardsFor() below (or replace it with a dedicated table); nothing else depends on the mapping.
+ * - Recording only: rewards are written to this ledger, not yet merged into the mainline inventory (that save format is
+ *   signed by the vendored progression module and is out of scope for this fix).
+ */
+export const R5_FIRSTCLEAR_KEY='forest-regional-r05-firstclear-v1';
+const REGION_INDEX:Record<string,number>={tide:0,meadow:1,sky:2};
+type Ledger={version:1;claimed:Record<string,{at:number;rewards:any[]}>};
+export function createR5FirstClearRewards(namespace:string,mainlineChests:()=>any[]){
+  const key=namespace+R5_FIRSTCLEAR_KEY;
+  const read=():Ledger|null=>{const raw=sys.localStorage.getItem(key);if(!raw)return {version:1,claimed:{}};
+    try{const v=JSON.parse(raw);return v&&v.version===1&&v.claimed&&typeof v.claimed==='object'?v:null;}catch{return null;}};
+  const rewardsFor=(region:string,ordinal:number)=>{const r=REGION_INDEX[region];if(r===undefined||!(ordinal>=1&&ordinal<=4))return null;
+    const chest=(mainlineChests()||[]).find((c:any)=>c.level===r*4+ordinal-1);return chest?JSON.parse(JSON.stringify(chest.rewards)):null;};
+  return {
+    claimed:(stageId:string)=>!!read()?.claimed[stageId],
+    rewardsFor,
+    /** Caller must have verified a recorded first clear (result.saved + completionRecorded). Idempotent. */
+    claim(stageId:string,region:string,ordinal:number){
+      const ledger=read();if(!ledger)return {ok:false,reason:'firstclear-ledger-corrupt',newlyGrantedRewards:[]};
+      if(ledger.claimed[stageId])return {ok:true,duplicate:true,rewards:ledger.claimed[stageId].rewards,newlyGrantedRewards:[]};
+      const rewards=rewardsFor(region,ordinal);if(!rewards)return {ok:false,reason:'no-reward-config',newlyGrantedRewards:[]};
+      ledger.claimed[stageId]={at:Date.now(),rewards};const text=JSON.stringify(ledger);
+      try{sys.localStorage.setItem(key,text);}catch(e){return {ok:false,reason:'persistence-error',newlyGrantedRewards:[]};}
+      if(sys.localStorage.getItem(key)!==text)return {ok:false,reason:'persistence-error',newlyGrantedRewards:[]};
+      return {ok:true,duplicate:false,rewards,newlyGrantedRewards:rewards};
+    },
+    inspect:()=>[R5_FIRSTCLEAR_KEY,sys.localStorage.getItem(key)],
+  };
+}
